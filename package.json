{
  "name": "lms-portal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "cd apps/web && npm run build",
    "dev": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "build:api": "npm run build --workspace=apps/api",
    "build:all": "npm run db:generate && npm run build:api && npm run build:web",
    "db:push": "cd apps/web && npx prisma db push",
    "db:generate": "npx prisma generate --schema=apps/web/prisma/schema.prisma"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.1.0"
  },
  "overrides": {
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "@rolldown/binding-linux-x64-musl": "1.2.3",
    "@rolldown/binding-win32-x64-msvc": "1.2.3",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}